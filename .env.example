# GEMINI_API_KEY: Required for Gemini AI API calls (ParkBot intelligent search and slot recommendations)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster0.mongodb.net/parkingspot)
# If empty or not reachable, the system automatically uses a high-performance in-memory Mongoose/MongoDB persistence engine with realistic seed data
MONGODB_URI="mongodb+srv://<user>:<password>@cluster0.mongodb.net/parkingspot?retryWrites=true&w=majority"

# JWT_SECRET: Secret key for signing JSON Web Tokens
JWT_SECRET="parkingspot_super_secret_jwt_key_2026"

# RAZORPAY CREDENTIALS: For Razorpay test mode payment processing
RAZORPAY_KEY_ID="rzp_test_yourKeyHere"
RAZORPAY_KEY_SECRET="yourSecretHere"

# GOOGLE MAPS API KEY: Optional Google Maps JavaScript API key (rich interactive fallback map built-in)
GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKey"

# ADMINISTRATOR PROVISIONING (Used by npm run seed:admin or server boot)
ADMIN_NAME="Platform Administrator"
ADMIN_EMAIL="admin@parkingspot.ai"
ADMIN_PASSWORD="yourStrongAdminPassword123!"

# SMTP EMAIL RECOVERY SERVICE (Optional: for automated password recovery email dispatch)
# If not configured, the password recovery flow generates a secure 15-minute token and surfaces an honest status in the UI
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT=587
SMTP_USER="postmaster@yourdomain.com"
SMTP_PASS="yourSmtpPassword"
SMTP_FROM="noreply@parkingspot.ai"

# Port configuration
PORT=3000
